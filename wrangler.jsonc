{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-proxy4",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "e3611e80-d388-4812-8695-c19d140cc28d","database_name": "nova-080f03-db" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "da3e4f3682664292a85ad19399f366ad" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
